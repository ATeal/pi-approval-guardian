{
  "name": "pi-approval-guardian-workspace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "npm run test --workspace=pi-approval-guardian",
    "test:artifact": "node --test scripts/pi-package-artifact.test.mjs",
    "test:pi-install": "node scripts/pi-package-install-smoke.mjs",
    "test:prime-native": "node scripts/prime-tracer-native-smoke.mjs",
    "typecheck": "npm run typecheck --workspace=pi-approval-guardian",
    "check": "npm run typecheck && npm test && npm run test:artifact && npm run test:pi-install",
    "package:check": "npm run test:artifact",
    "publish:check": "npm publish --dry-run --workspace=pi-approval-guardian"
  }
}
